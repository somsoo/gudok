---
// 비교·카테고리 페이지용: 서비스별 최저 유료 요금의 1년 비용
import { cheapest, officialPlans, planKrw, svc, svcUrl, vatKrw, won } from '../lib/data';

interface Props { ids: string[] }
const svcs = Astro.props.ids.map(svc).filter((s) => cheapest(s));
const hasAds = svcs.some((s) => officialPlans(s).some((p) => p.ads));
const hasUsd = svcs.some((s) => officialPlans(s).some((p) => p.usd != null));
const extra = hasAds ? '광고 없는 최저 1년' : hasUsd ? '부가세 10% 포함 추정' : '';
const rows = svcs.map((s) => {
  const low = cheapest(s)!;
  const lv = planKrw(low)!;
  let extraCell: string | null = null;
  if (hasAds) {
    const na = cheapest(s, { noAds: true });
    extraCell = na ? won(planKrw(na)! * 12) : '—';
  } else if (hasUsd) {
    extraCell = low.usd != null ? won(vatKrw(lv) * 12) : '—';
  }
  return { s, low, year: won(lv * 12), extraCell };
});
---
{svcs.length >= 2 && (
<Fragment>
<h2>1년 기준으로 보면</h2><p>공식 웹 요금으로 12개월 동안 냈을 때의 금액입니다. 결합·제휴 할인이나 연간 결제를 쓰면 이보다 줄어듭니다.</p>
<div class="table-wrap"><table class="cmp stack"><thead><tr><th>서비스</th><th>최저 유료 요금제</th><th>1년 비용</th>{extra && <th>{extra}</th>}</tr></thead><tbody>
{rows.map(({ s, low, year, extraCell }) => (
<tr><th scope="row"><a href={svcUrl(s)}>{s.name}</a></th><td data-label="최저 유료 요금제">{low.name}</td><td class="num" data-label="1년 비용"><strong>{year}</strong></td>{extraCell !== null && <td class="num" data-label={extra}>{extraCell}</td>}</tr>
))}
</tbody></table></div>
</Fragment>
)}
