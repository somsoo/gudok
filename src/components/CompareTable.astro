---
// 서비스 비교표. <CompareTable ids={['netflix', 'tving']} /> 또는 <CompareTable cat="ai" />
import { SERVICES, cellPrice, cheapest, officialPlans, svc, svcUrl } from '../lib/data';

interface Props { ids?: string[]; cat?: string }
const { ids: given, cat } = Astro.props;
const ids = given ?? SERVICES.filter((s) => s.cat === cat).map((s) => s.id);
const rows = ids.map((i) => {
  const s = svc(i);
  return { s, low: cheapest(s), noads: cheapest(s, { noAds: true }) };
});
const hasAds = rows.some(({ s }) => officialPlans(s).some((p) => p.ads));
---
<div class="table-wrap"><table class="cmp stack"><thead><tr><th>서비스</th><th>공식 최저 유료</th>{hasAds && <th>광고 없는 최저</th>}<th>동시 이용</th><th>강점</th></tr></thead><tbody>
{rows.map(({ s, low, noads }) => (
<tr><th scope="row"><a href={svcUrl(s)}>{s.name}</a></th><td data-label="공식 최저 유료">{cellPrice(low)}</td>{hasAds && <td data-label="광고 없는 최저">{cellPrice(noads)}</td>}<td data-label="동시 이용">{s.streams || '—'}</td><td data-label="강점">{s.short}</td></tr>
))}
</tbody></table></div>
