---
// 앱 결제가 웹보다 비싼 요금제 (plans 의 app_higher). 앱 결제 금액은 매주 확인할 수 없어 적지 않고, 확인된 웹 가격만 보여 준다.
import { SERVICES, nf, svcUrl } from '../lib/data';

const rows = SERVICES.flatMap((s) => s.plans.filter((p) => p.app_higher && p.price).map((p) => ({ s, p })));
---
{rows.length > 0 && (
<Fragment>
<div class="table-wrap"><table class="cmp stack"><thead><tr><th>서비스</th><th>요금제</th><th>웹 결제</th><th>앱 결제</th></tr></thead><tbody>
{rows.map(({ s, p }) => (
<tr><th scope="row"><a href={svcUrl(s)}>{s.name}</a></th><td data-label="요금제">{p.name}</td><td class="num" data-label="웹 결제">{`월 ${nf(p.price!)}원`}</td><td data-label="앱 결제">웹보다 비쌈</td></tr>
))}
</tbody></table></div>
<p class="muted">앱 결제 금액은 앱 마켓 가격 정책에 따라 바뀔 수 있어 적지 않았습니다. 결제 전에 앱 결제 화면에서 금액을 확인하세요.</p>
</Fragment>
)}
