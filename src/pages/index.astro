---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { BASE, BRAND, CAT_ORDER, COPY, SERVICES, SITE, TODAY, cellPrice, cheapest, svcUrl } from '../lib/data';
import { META, sorted } from '../lib/registry';

const m = META.home;
const cats = await sorted('categories');
const catH1 = (cat: string) => cats.find((c) => c.id === cat)?.data.h1 ?? cat;
const compares = await sorted('compare');
const guides = await sorted('guides');
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND, url: `${BASE}/`, inLanguage: 'ko-KR' }];
---
<Base path={m.path} title={m.title} desc={m.desc} ld={ld} disclosure>
<section class="hero">
<h1>{SITE.tagline}</h1>
<p>{COPY.home.intro}</p>
<p><a class="btn btn-primary" href="/tools/subscription-calculator/">내 구독료 계산하기</a> <a class="btn" href="/tools/ott-finder/">나에게 맞는 OTT 찾기</a></p>
</section>
<AdSlot pos="top" />
<section><h2>서비스별 공식 최저가와 절약 포인트</h2>
<p class="meta">요금 확인: {TODAY}</p>
<div class="table-wrap"><table class="cmp stack"><thead><tr><th>서비스</th><th>공식 최저 유료 요금제</th><th>더 싸게 쓰는 방법</th></tr></thead><tbody>
{SERVICES.map((s) => <tr><th scope="row"><a href={svcUrl(s)}>{s.name}</a></th><td data-label="공식 최저 유료 요금제">{cellPrice(cheapest(s))}</td><td data-label="더 싸게 쓰는 방법">{s.quick.cheapest}</td></tr>)}
</tbody></table></div>
</section>
{CAT_ORDER.map((cat) => (
<section><h2><a href={`/${cat}/`}>{catH1(cat)}</a></h2><div class="grid">{SERVICES.filter((s) => s.cat === cat).map((s) => <ServiceCard s={s} />)}</div></section>
))}
<section class="two"><div><h2>많이 보는 비교</h2><ul class="list">{compares.map((c) => <li><a href={`/compare/${c.id}/`}>{c.data.h1}</a></li>)}</ul></div>
<div><h2>절약 가이드</h2><ul class="list">{guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.h1}</a></li>)}</ul></div></section>
<section class="trust"><h2>이 사이트의 원칙</h2><p>{COPY.home.trust} <a href="/editorial-policy/">편집 원칙 보기</a></p></section>
</Base>
