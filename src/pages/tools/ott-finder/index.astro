---
// 나에게 맞는 OTT 찾기. 동작은 public/assets/app.js 가 window.__FINDER 를 읽어 처리한다.
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Faq from '../../../components/Faq.astro';
import FinderGuide from '../../../partials/finder-guide.mdx';
import { COPY, TODAY, faqLd, finderData, safeJson, webAppLd } from '../../../lib/data';
import { META } from '../../../lib/registry';

const m = META.finder;
type Question = { id: string; q: string; multi: boolean; options: { value: string; label: string }[] };
const questions: Question[] = COPY.finder.questions;
const ld = [...webAppLd('나에게 맞는 OTT 찾기', m.path, 'UtilityApplication'), ...faqLd(COPY.finder.faq)];
---
<Base path={m.path} title={m.title} desc={m.desc} crumbs={[['도구', '/tools/'], ['OTT 찾기', m.path]]} ld={ld}>
<article class="doc">
<h1>나에게 맞는 OTT 찾기</h1>
<p class="lead">보는 콘텐츠, 광고 허용 여부, 함께 볼 인원, 예산 4가지만 고르면 요금 데이터 기준으로 맞는 OTT와 가장 싼 요금제를 추천합니다.</p>
<AdSlot pos="top" />
<form id="finder" class="tool" onsubmit="return false">{questions.map((q) => (
<fieldset><legend>{q.q}</legend>{q.options.map((o) => <label class="opt"><input type={q.multi ? 'checkbox' : 'radio'} name={q.id} value={o.value}>{` ${o.label}`}</label>)}</fieldset>
))}
<p class="actions"><button type="button" class="btn btn-primary" id="finder-go">추천 받기</button> <button type="button" class="btn" id="finder-reset">다시 고르기</button></p>
<div id="finder-result" aria-live="polite"></div></form>
<p class="muted">※ 요금 데이터와 서비스 강점 기준의 참고용 추천입니다. 요금 확인 {TODAY}.</p>
<FinderGuide />
<Faq items={COPY.finder.faq} />
</article>
<script is:inline set:html={`window.__FINDER=${safeJson(finderData())};`}></script>
</Base>
